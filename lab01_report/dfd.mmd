%% DFD: система обліку відвідуваності занять (варіант 5).
%% Ідентифікатори E/P/D/F використовуються в таблицях STRIDE та CVSS.
flowchart LR
    stu([E1 Студент]):::ext
    tea([E2 Викладач]):::ext
    sso([E3 Університетський SSO]):::ext
    subgraph TB1[Межа довіри: застосунок]
        api[P1 Вебзастосунок]
        mark[P2 Сервіс відміток]
    end
    subgraph TB2[Межа довіри: сховища]
        db[(D1 БД відвідуваності)]
        log[(D2 Журнал аудиту)]
    end
    stu -->|F1 QR-токен| api
    tea -->|F3 коригування| api
    sso -->|F6 ID-токен| api
    api --->|F2 статус відмітки| stu
    api --->|F4 QR-код, звіт| tea
    api --->|F5 код OIDC| sso
    api -->|F7 запит відмітки| mark
    mark -->|F8 результат| api
    mark -->|F9 SQL: запис відмітки| db
    db -->|F10 розклад, відмітки| mark
    mark -->|F11 подія аудиту| log

    classDef ext fill:#eee,stroke:#333;

%% DFD: платформа онлайн-курсів із перевіркою завдань (варіант 7).
%% Ідентифікатори E/P/D/F використовуються в таблицях STRIDE та CVSS.
flowchart LR
    stu([E1 Студент]):::ext
    tea([E2 Викладач]):::ext
    sso([E3 Університетський SSO]):::ext
    subgraph TB1[Межа довіри: застосунок]
        api[P1 Вебзастосунок]
    end
    subgraph TB2[Межа довіри: пісочниця перевірки]
        grader[P2 Сервіс автоперевірки]
    end
    subgraph TB3[Межа довіри: сховища]
        db[(D1 БД курсів і оцінок)]
        files[(D2 Сховище робіт і тестів)]
    end
    stu -->|F1 робота, запити| api
    tea -->|F3 завдання, тести, оцінки| api
    sso -->|F6 ID-токен| api
    api --->|F2 оцінка, відгук| stu
    api --->|F4 роботи, відомість| tea
    api --->|F5 запит OIDC| sso
    api -->|F7 задача перевірки| grader
    grader -->|F8 результат тестів| api
    api -->|F9 SQL: оцінки, курси| db
    db -->|F10 курси, ролі, оцінки| api
    api -->|F11 файл роботи| files
    files -->|F12 робота, тести| grader

    classDef ext fill:#eee,stroke:#333;
